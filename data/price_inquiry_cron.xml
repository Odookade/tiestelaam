<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_price_inquiry" model="ir.cron">
        <field name="name">استعلام روزانه قیمت</field>
        <field name="model_id" ref="model_price_inquiry"/>
        <field name="state">code</field>
